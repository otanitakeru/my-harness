{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/block-dangerous.sh",
            "statusMessage": "危険なコマンドの確認"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/scripts/hooks/format-changed.sh",
            "statusMessage": "変更したファイルの整形"
          }
        ]
      }
    ]
  }
}
